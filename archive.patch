+import type { SessionInfo } from "@opencode/client/promise"
+import { useQueryClient } from "@tanstack/solid-query"
+import { useLanguage } from "@/runtime/i18n/language"
+import { ServerConnection } from "@/runtime/server/registry"
+import { useGlobal } from "@/runtime/server/runtime"
+import { notifySessionTabsRemoved } from "@/shell/titlebar/session-events"
+
+export const ARCHIVED_SESSIONS_QUERY_KEY = "archived-sessions"
+
+/** Archives or restores a session and refreshes every list that shows it. */
+export function createSessionArchiver() {
+  const global = useGlobal()
+
+  const language = useLanguage()
+
+  const queryClient = useQueryClient()
+
+  return async (server: ServerConnection.Key, session: SessionInfo, archived: boolean) => {
+    const ctx = global.serverCtx(server)
+
+    if (!ctx) throw new Error(language.t("common.requestFailed"))
+    await ctx.sdk.api.session.update({ sessionID: session.id, archived })
+
+    const current = ctx.data.session.get(session.id)
+
+    if (current)
+      ctx.data.session.remember({
+        ...current,
+        time: { ...current.time, archived: archived ? (current.time.archived ?? Date.now()) : undefined },
+      })
+
+    // Archiving removes the session's tabs for good, so reopening the tab stack cannot bring it back.
+    if (archived)
+      notifySessionTabsRemoved({
+        server,
+        directory: session.location.directory,
+        sessionIDs: [session.id],
+      })
+
+    await Promise.all(
+      [
+        [ARCHIVED_SESSIONS_QUERY_KEY],
+        ["home-sessions"],
+        ["project-sessions"],
+        ["inbox-sessions"],
+        ["inbox-archived-sessions"],
+      ].map((queryKey) => queryClient.invalidateQueries({ queryKey })),
+    )
+  }
+}
