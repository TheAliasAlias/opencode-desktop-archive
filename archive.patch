@@ -0,0 +1,163 @@
+import type { SessionInfo } from "@opencode/client/promise"
+import { useQueries, useQueryClient } from "@tanstack/solid-query"
+import { Schema } from "effect"
+import { createEffect, createMemo, For, onCleanup, Show } from "solid-js"
+import { Icon } from "@opencode/ui/icon"
+import { useLanguage } from "@/runtime/i18n/language"
+import { Persistence } from "@/runtime/persistence/schema"
+import { Persist, persisted } from "@/runtime/persistence/storage"
+import { ServerConnection, useServers } from "@/runtime/server/registry"
+import { useGlobal, type ServerCtx } from "@/runtime/server/runtime"
+import { useTabs } from "@/shell/tabs/tabs"
+import { ARCHIVED_SESSIONS_QUERY_KEY } from "@/session/commands/archive-session"
+import { ProjectSessionRow } from "./project-session-row"
+
+const ARCHIVED_SESSION_LIMIT = 50
+
+const ArchiveSidebarState = Persistence.struct({
+  expanded: Schema.Boolean,
+})
+
+// Keep the immutable result opaque so Solid Query does not recursively unwrap every session.
+const selectSessions = (sessions: SessionInfo[]) => () => sessions
+
+type ArchivedEntry = {
+  key: string
+  conn: ServerConnection.Any
+  server: ServerConnection.Key
+  ctx: ServerCtx
+  session: SessionInfo
+}
+
+/**
+ * The collapsible Archive fold shared by the vertical sidebars. It lists the newest archived root sessions on every
+ * visible server and keeps the rows live as sessions are archived, restored or deleted.
+ */
+export function ArchiveSessions() {
+  const language = useLanguage()
+
+  const global = useGlobal()
+
+  const servers = useServers()
+
+  const tabs = useTabs()
+
+  const queryClient = useQueryClient()
+
+  const [state, setState] = persisted(Persist.global("sidebar.archive"), ArchiveSidebarState, { expanded: false })
+
+  const connections = createMemo(() =>
+    servers.visible.flatMap((conn) => {
+      const server = ServerConnection.key(conn)
+      const ctx = global.serverCtx(server)
+
+      return ctx ? [{ conn, server, ctx }] : []
+    }),
+  )
+
+  const queries = useQueries(() => ({
+    queries: connections().map((item) => ({
+      queryKey: [ARCHIVED_SESSIONS_QUERY_KEY, item.conn] as const,
+      enabled: item.ctx.sdk.connection.status() === "connected",
+      queryFn: ({ signal }: { signal: AbortSignal }) =>
+        item.ctx.sdk.api.session
+          .list({ limit: ARCHIVED_SESSION_LIMIT, order: "desc", parentID: null, archived: true }, { signal })
+          .then((response) => response.data),
+      retry: false,
+      staleTime: 30_000,
+      refetchOnMount: true,
+      refetchOnReconnect: true,
+      select: selectSessions,
+    })),
+  }))
+
+  // Archive changes can come from another window, the inbox, or a search dialog. Refresh the fold as they land.
+  createEffect(() => {
+    connections().forEach((item) => {
+      const refresh = () =>
+        void queryClient.invalidateQueries({ queryKey: [ARCHIVED_SESSIONS_QUERY_KEY, item.conn], exact: true })
+
+      onCleanup(item.ctx.data.on("session.archived", refresh))
+      onCleanup(item.ctx.data.on("session.unarchived", refresh))
+      onCleanup(item.ctx.data.on("session.deleted", refresh))
+    })
+  })
+
+  const entries = createMemo(() => {
+    const seen = new Set<string>()
+
+    return connections()
+      .flatMap((item, index): ArchivedEntry[] =>
+        (queries[index]?.data?.() ?? []).flatMap((session) => {
+          const key = `${item.server}\0${session.id}`
+
+          if (seen.has(key) || session.time.archived === undefined) return []
+          seen.add(key)
+
+          return [{ key, conn: item.conn, server: item.server, ctx: item.ctx, session }]
+        }),
+      )
+      .toSorted(
+        (a, b) =>
+          (b.session.time.updated ?? b.session.time.created) - (a.session.time.updated ?? a.session.time.created),
+      )
+  })
+
+  const open = (entry: ArchivedEntry) => {
+    void entry.ctx.projects.touch(entry.session.location.directory)
+    void entry.ctx.data.session.message.sync(entry.session.id).catch(() => undefined)
+    tabs.select(tabs.addSessionTab({ server: entry.server, sessionId: entry.session.id }))
+  }
+
+  return (
+    <section data-slot="sidebar-archive" class="flex w-full shrink-0 flex-col gap-1 pt-1">
+      <button
+        type="button"
+        data-action="sidebar-archive-toggle"
+        class="group/archive flex h-7 min-w-0 w-full shrink-0 items-center rounded-[6px] pe-1 hover:bg-v2-overlay-simple-overlay-hover focus-visible:bg-v2-overlay-simple-overlay-hover"
+        aria-expanded={state.expanded}
+        onClick={() => setState("expanded", !state.expanded)}
+      >
+        <span class="flex h-full min-w-0 flex-1 items-center gap-1.5 rounded-[6px] px-2 text-start text-[13px] leading-[var(--line-height-compact)] text-v2-text-text-muted group-hover/archive:text-v2-text-text-base focus-visible:text-v2-text-text-base focus-visible:outline-none">
+          <Icon name="archive" class="size-4 shrink-0 text-v2-icon-icon-muted" />
+          <span class="min-w-0 flex-1 truncate">{language.t("common.archive")}</span>
+          <Show when={entries().length > 0}>
+            <span class="shrink-0 text-[11px] leading-[var(--line-height-compact)] text-v2-text-text-faint [font-weight:400]">
+              {entries().length}
+            </span>
+          </Show>
+          <Icon
+            name="fill-triangle-down"
+            class="shrink-0 text-v2-icon-icon-muted transition-transform motion-reduce:transition-none"
+            classList={{ "-rotate-90 rtl:rotate-90": !state.expanded }}
+          />
+        </span>
+      </button>
+      <Show when={state.expanded}>
+        <div data-slot="sidebar-archive-list" class="flex min-w-0 flex-col gap-[3px]">
+          <Show
+            when={entries().length > 0}
+            fallback={
+              <div class="ps-8 pe-2 py-2 text-12-regular text-v2-text-text-faint">
+                {language.t("sidebar.organize.empty")}
+              </div>
+            }
+          >
+            <For each={entries()}>
+              {(entry) => (
+                <ProjectSessionRow
+                  server={entry.server}
+                  session={entry.session}
+                  openTab={false}
+                  active={false}
+                  label={connections().length > 1 ? servers.label(entry.conn) : undefined}
+                  onOpen={() => open(entry)}
+                />
+              )}
+            </For>
+          </Show>
+        </div>
+      </Show>
+    </section>
+  )
+}
